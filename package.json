{
  "name": "personal-finance-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:setup": "npm run db:setup --workspace server",
    "migrate": "npm run migrate --workspace server",
    "migrate:down": "npm run migrate:down --workspace server",
    "test:parser": "npm run test:parser --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}