PORT=5000
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_management

# Telegram local bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
AUTH_SESSION_DAYS=30
# Set COOKIE_SECURE=0 saat dev via http (localhost). Di produksi HTTPS biarkan default (1).
COOKIE_SECURE=0

# URL publik (server & frontend) untuk OAuth/link
PUBLIC_BASE=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (kosongkan untuk menonaktifkan tombol Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP untuk fitur lupa kata sandi (kosongkan untuk menonaktifkan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FluXa <no-reply@fluclight.my.id>